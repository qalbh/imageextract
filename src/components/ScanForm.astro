---
// Native GET form: submitting navigates to /results?url= with zero JavaScript,
// which is what makes shared scan links work at all. Focus is an accent outline,
// not a ring — box-shadows are on the design-system NEVER list.
//
// Two variants share the #scan-url input (the island prefills it, and both
// pages must expose exactly one):
//   default  — the big hero input + Extract button, for the landing page
//   compact  — a SOURCE row for /results: label, the URL as a bordered chip
//              with a clear ×, and a Re-scan URL link. The × clears by
//              navigating to a bare /results (zero JS).
//
// The default variant takes a <slot> for hidden inputs: /tools/<variant> pages
// append ?format=/?source= that way, so a page promising "every PNG" hands off
// a PNG-filtered grid without a line of JavaScript.
interface Props {
	variant?: 'default' | 'compact';
	placeholder?: string;
}
const { variant = 'default', placeholder = 'https://example.com' } = Astro.props;
---

{
	variant === 'compact' ? (
		<form method="get" action="/results" class="flex min-w-0 items-center gap-sm">
			<span class="shrink-0 font-mono text-label uppercase text-muted">Source</span>
			{/* Chip sized to its content, not the row: .source-input tracks the URL
			    via field-sizing where supported, 28ch ellipsized fallback elsewhere. */}
			<span class="flex min-w-0 items-center gap-xs rounded-md border border-border bg-surface px-sm py-xs focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-accent">
				<input
					id="scan-url"
					name="url"
					type="url"
					required
					placeholder="https://example.com"
					class="source-input min-w-0 truncate border-0 bg-transparent p-0 font-mono text-caption text-text placeholder:text-muted focus:outline-none"
				/>
				<a
					href="/results"
					aria-label="Clear source"
					class="shrink-0 font-mono text-caption text-muted hover:text-text"
				>
					×
				</a>
			</span>
			<button
				type="submit"
				class="shrink-0 font-mono text-caption text-accent hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
			>
				Re-scan URL
			</button>
		</form>
	) : (
		<form method="get" action="/results" class="flex gap-xs">
			<slot />
			<input
				id="scan-url"
				name="url"
				type="url"
				required
				placeholder={placeholder}
				class="w-full rounded-md border border-border bg-surface px-sm py-xs text-body text-text placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
			/>
			<button
				type="submit"
				class="shrink-0 rounded-md bg-accent px-md py-xs text-small font-medium text-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
			>
				Extract
			</button>
		</form>
	)
}

<style>
	/* Compact source chip on /results: the input sizes to its content where
	   field-sizing exists (Chromium); elsewhere it falls back to a fixed 28ch
	   that the `truncate` utility ellipsizes — deliberate truncation, not a
	   broken control.
	   Scoped here rather than in global.css: this is ScanForm's own CSS and
	   the element is in this file's template, so Astro's scoping reaches it
	   (docs/design-system.md, "Where CSS lives"). */
	.source-input {
		width: 28ch;
		max-width: 100%;
	}
	@supports (field-sizing: content) {
		.source-input {
			field-sizing: content;
			width: auto;
			/* Cap so an enormous URL can't push Re-scan off the row. */
			max-width: 48ch;
		}
	}
</style>
