---
import '../styles/global.css';
// Imported for its content-hashed URL so we can preload the above-the-fold
// display face (carries the H1/LCP glyphs). Same source as the @font-face
// url(), so Vite emits one hashed file and both references share it.
import displayFont from '../styles/fonts/schibsted-grotesk-latin-400-700.woff2';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'imageextract — extract images from any web page',
	description = 'Free tool that lists every image on a public web page — preview, check formats and dimensions, and download.',
} = Astro.props;

// Absolute URLs for social meta — relative og:image fails on most
// platforms. Astro.site comes from astro.config's `site`. The og:image
// dimensions are the DECLARED display size (1200×630); the file itself is
// a 2× source (2400×1260), which platforms handle fine.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		{/* Preload only the display face used above the fold (H1/LCP). Mono
		    isn't preloaded — its only above-fold use is the wordmark badge. */}
		<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="ImageExtract" />
		<meta property="og:url" content={pageUrl.href} />
		<meta property="og:image" content={ogImage.href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage.href} />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
