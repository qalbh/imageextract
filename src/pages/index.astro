---
import Layout from '../layouts/Layout.astro';
import ResultsGrid from '../components/ResultsGrid';
---

<Layout>
	<main class="mx-auto max-w-5xl px-4 py-10">
		<h1 class="text-2xl font-bold text-neutral-900">Extract images from any web page</h1>
		<p class="mt-1 text-neutral-600">
			Paste a page URL and get every image on it — previews, formats, and dimensions.
		</p>

		{/* Native GET form: submitting reloads with ?url= — no JavaScript. */}
		<form method="get" action="/" class="mt-6 flex gap-2">
			<input
				id="scan-url"
				name="url"
				type="url"
				required
				placeholder="https://example.com/gallery"
				class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none"
			/>
			<button
				type="submit"
				class="shrink-0 rounded-md bg-neutral-900 px-5 py-2 text-sm font-medium text-white hover:bg-neutral-700"
			>
				Scan
			</button>
		</form>

		<p class="mt-8 border-b border-neutral-200 pb-2 text-xs text-neutral-500">
			Images belong to their creators. Only download what you have the right to use.
		</p>

		<div class="mt-6">
			<ResultsGrid client:load />
		</div>
	</main>
</Layout>
