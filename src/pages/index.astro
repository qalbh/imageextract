---
import Layout from '../layouts/Layout.astro';
import ScanForm from '../components/ScanForm.astro';
---

<Layout>
	<main class="mx-auto max-w-5xl px-4 py-10">
		<h1 class="text-2xl font-bold text-neutral-900">Extract images from any web page</h1>
		<p class="mt-1 text-neutral-600">
			Paste a page URL and get every image on it — previews, formats, and dimensions.
		</p>

		<ScanForm />
	</main>
</Layout>
