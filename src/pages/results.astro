---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ScanForm from '../components/ScanForm.astro';
import ResultsGrid from '../components/ResultsGrid';
/* Component CSS for this view only. Page-level, not imported from
   ResultsGrid.tsx: an island import ships with the island's JS and flashes
   unstyled tiles. Unscoped because Preact components apply the classes and
   Astro's scoping only reaches .astro templates. */
import '../styles/results.css';
---

<Layout title="Scan results — imageextract">
	<Fragment slot="head">
		{/* Scans of arbitrary third-party pages: keep them out of the index and
		    don't let crawlers follow out to them. */}
		<meta name="robots" content="noindex, nofollow" />
		{/* Thumbnails load direct from origin; without this, every image host
		    would receive a Referer containing the scanned page's URL. */}
		<meta name="referrer" content="no-referrer" />
		{/* The ?url= space is unbounded; collapse it to one canonical URL. */}
		<link rel="canonical" href="https://imageextract.pics/results" />
	</Fragment>

	<SiteHeader anchorPrefix="/" wide />

	{/* Full-bleed shell, not max-w-content: /results is a scanning surface —
	    see the reading-vs-scanning rule in docs/design-system.md. */}
	<main class="results-shell py-lg">
		{/* Compact SOURCE row (not the big hero input): the scanned URL as a chip
		    with a clear ×, and a Re-scan link. */}
		<ScanForm variant="compact" />

		{/* The copyright/zero-persistence notice lives INSIDE the island (accent
		    alert, dismissible, reappears every scan — the dismissal must not
		    persist). With JS off the island doesn't render, so there is no grid
		    and no download path — nothing for the notice to caveat. */}
		<div class="mt-md">
			<ResultsGrid client:load />
		</div>
	</main>
</Layout>
