{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "types": [
      "./worker-configuration.d.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "react": ["./node_modules/preact/compat/src/index.d.ts"],
      "react-dom": ["./node_modules/preact/compat/src/index.d.ts"]
    }
  }
}