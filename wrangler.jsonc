{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-05",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "imageextract",
	// THIS FILE IS NOT THE CONFIG WRANGLER DEPLOYS. Read this before
	// "fixing" anything below, especially `assets.directory`.
	// The Astro adapter writes a RESOLVED config to
	// `dist/server/wrangler.json` at build time and points wrangler at it
	// via `.wrangler/deploy/config.json` (wrangler's config-redirect
	// mechanism). `wrangler deploy` from the repo root prints "Using
	// redirected Wrangler configuration" and uses THAT file. This one is
	// the INPUT it is generated from: settings here propagate (verified
	// for routes, limits, kv_namespaces, workers_dev, html_handling), but
	// two are REWRITTEN in the output and the values here are misleading
	// if read literally:
	//   main             "@astrojs/cloudflare/entrypoints/server" → "entry.mjs"
	//   assets.directory "./dist"                                 → "../client"
	// So `./dist` does NOT mean the whole dist tree ships as public
	// assets — only `dist/client` does, and `dist/server` ships as the
	// Worker. Confirmed at the first deploy by counting the actual
	// upload: 38 files, all from dist/client, zero source or markdown.
	// Changing `assets.directory` here to "./dist/client" to "correct"
	// it would be wrong — the adapter resolves it RELATIVE TO
	// dist/server, and the value it writes is already right.
	// (`.wrangler/deploy/config.json` also names a
	// `dist/server/.prerender/wrangler.json` that the build does not
	// create. It is regenerated fresh every build, wrangler ignores it,
	// and the first deploy was clean — not a stale file, not a problem.)
	"main": "@astrojs/cloudflare/entrypoints/server",
	// CUSTOM DOMAIN, not a route pattern — chosen because the hostname
	// belongs entirely to this Worker. There is no second origin in this
	// zone: one Worker serves the site AND /api/*, so there is nothing to
	// split traffic with. A route pattern would additionally require a
	// placeholder DNS record maintained by hand, whose only job is to give
	// Cloudflare something to intercept. custom_domain creates the DNS
	// record and the certificate together and keeps them with the Worker.
	// Declared here rather than clicked in the dashboard so the binding is
	// version-controlled and reproducible from a clean checkout.
	"routes": [{ "pattern": "imageextract.pics", "custom_domain": true }],
	// PINNED, not inherited. Adding `routes` makes wrangler disable
	// workers.dev by default and warn about it — so this was already the
	// live behaviour, arrived at by default rather than by decision. The
	// decision: imageextract.qalb2096.workers.dev must NOT serve the site,
	// because a second hostname serving byte-identical, indexable content
	// is duplicate content competing with the domain the entire
	// acquisition channel depends on — and every absolute URL we emit
	// (og:url, canonical, sitemap) names the apex, so the workers.dev copy
	// would be the one with no correct self-reference. Stated explicitly
	// so a future reader sees a choice rather than a default, and so
	// removing `routes` cannot silently re-expose it.
	"workers_dev": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// THE BARE URL IS CANONICAL, and this is the line that makes it so.
		// The User-Agent advertises https://imageextract.pics/traffic — the
		// least changeable string we own, since it lands in third-party
		// access logs and stays there for years. Under the default
		// ("auto-trailing-slash") that URL 307s to /traffic/, because Astro
		// emits traffic/index.html and the assets layer canonicalises a
		// directory to the slashed form. So the redirect is a RUNTIME
		// decision, not an Astro one — Astro's `trailingSlash` cannot remove
		// it (setting that alone just repoints the sitemap at a URL that
		// still redirects). "drop-trailing-slash" inverts it: /traffic
		// serves 200 directly and /traffic/ redirects instead, which is the
		// direction that costs nothing, because nothing we publish uses the
		// slashed form. astro.config's trailingSlash: 'never' is the other
		// half — it aligns og:url and the sitemap with what this serves.
		// Verified against `wrangler dev` before deploying, on a harness
		// first checked to reproduce the production 307.
		"html_handling": "drop-trailing-slash"
	},
	// Operator domain blocklist — READ-ONLY from the Worker. The
	// zero-persistence carve-out (AGENTS.md "Politeness" / DECISIONS.md):
	// the rule targets retention of USER data, this list holds none, and
	// the Worker never writes it. Namespace created 2026-08-12 at the
	// first deploy; the id is a resource identifier, not a secret (reads
	// still require account auth), which is why it lives in the repo.
	// Until a `domains` key is written, the list is EMPTY and every
	// lookup is a clean miss — the code fails open by design, so an
	// empty namespace blocks nothing. /terms' exclusion promise is
	// deliverable from now on: it needs an operator to add a line, not a
	// deploy. Local dev uses miniflare's simulated KV, which ignores
	// this id.
	"kv_namespaces": [{ "binding": "BLOCKLIST", "id": "b4ef65c2b3e346eaa02dca44e839468a" }],
	// Runaway-bug guards, not cost optimizers — both sized to be
	// unreachable by honest traffic, so firing means a logic bug.
	// cpu_ms: measured worst case (5 MB candidate-dense document incl.
	// 1 MB noscript, full extract+finalize) = 1,570 ms on the dev
	// machine; ×4 for the STATED ASSUMPTION that a shared production
	// core is slower than this laptop, ×~5 headroom → 30,000. Rounded
	// generously on purpose: a too-high cpu_ms costs nothing, a too-low
	// one kills requests on slow colos in a way that is very hard to
	// diagnose from the outside. (Proxy streaming measured 10 ms for
	// 50 MB — CPU lives in the parser, not the proxy.)
	// subrequests: worst structural scan = 61 (derivation and the
	// counting test that re-checks it: src/lib/subrequest-budget.test.ts,
	// which also asserts this value keeps ≥1.5× headroom).
	"limits": {
		"cpu_ms": 30000,
		"subrequests": 100
	},
	// KEEP DISABLED (log-audit Finding A): our endpoint URLs embed the
	// user's scanned URL (/api/scan?url=…), so enabling ANY invocation
	// logging here — observability, Logpush, tail workers — captures
	// every user's URL with zero code changes, violating the no-URLs-
	// in-logs constraint (AGENTS.md "No URLs in logs binds
	// configuration"). This flag was once found enabled while the audit
	// claimed otherwise; it is now TESTED, not remembered — doc-sync
	// asserts enabled === false and fails the suite on any regenerated
	// or pasted-over version of this file. If logging is ever truly
	// wanted, it ships only after URL redaction is verified, and the
	// doc-sync assertion changes in the same commit as the flag.
	"observability": {
		"enabled": false
	}
}